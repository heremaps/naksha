        <mxCell id="XuQO3tHAvvKQnDVfzfl5-83" parent="bNCgAfvZQ5hsA_kJCly6-85" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="getDouble(int refId): double" vertex="1">
