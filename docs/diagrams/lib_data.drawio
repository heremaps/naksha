          <mxGeometry height="28" width="440" y="26" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-96" parent="XuQO3tHAvvKQnDVfzfl5-90" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;abstract&lt;/font&gt;&lt;/i&gt; valueClass(): Class&amp;lt;T&amp;gt;" vertex="1">
          <mxGeometry height="28" width="440" y="54" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-94" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="A small helper class that can be extended to get support for a standard list implementation, enforces type safety. The implementation will throw &lt;i style=&quot;&quot;&gt;IllegalStateException&lt;/i&gt; when it finds invalid data in the underlying array." vertex="1">
          <mxGeometry height="80" width="440" x="5380" y="1050" as="geometry" />
        </mxCell>
