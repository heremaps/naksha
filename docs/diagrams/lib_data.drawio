        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-96" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="General static singleton to handle Naksha data classes. The JSON parser will ensure that it only returns valid primitives or DataObject&#39;s. This class handles garbage collection of collected weak references using a ReferenceQueue, which is true for interned values as well as for the data bytes." vertex="1">
          <mxGeometry height="120" width="600" x="40" y="240" as="geometry" />
        </mxCell>
