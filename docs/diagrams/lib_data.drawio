        <mxCell id="CrYzsB_NNo0B62X1mgjU-86" parent="CrYzsB_NNo0B62X1mgjU-51" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="addAlias(OptionValue value): NS" vertex="1">
