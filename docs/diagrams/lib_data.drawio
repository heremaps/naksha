        </mxCell>
        <mxCell id="CrYzsB_NNo0B62X1mgjU-156" parent="CrYzsB_NNo0B62X1mgjU-138" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="storeTuple(Tuple tuple, BiConsumer&amp;lt;DataError, Tuple&amp;gt;? onError, Consumer&amp;lt;Tuple&amp;gt;? onSuccess): boolean" vertex="1">
          <mxGeometry height="28" width="720" y="166" as="geometry" />
        </mxCell>
        <mxCell id="CrYzsB_NNo0B62X1mgjU-157" parent="CrYzsB_NNo0B62X1mgjU-138" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="storeTuples(List&amp;lt;Tuple&amp;gt; tuples, BiConsumer&amp;lt;DataError, List&amp;lt;Tuple&amp;gt;&amp;gt;? onError, Consumer&amp;lt;List&amp;lt;Tuple&amp;gt;&amp;gt;? onSuccess): boolean" vertex="1">
          <mxGeometry height="28" width="720" y="194" as="geometry" />
        </mxCell>
        <mxCell id="CrYzsB_NNo0B62X1mgjU-147" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="Data is organized in databases, no matter from which storage it is read. All databases are organized within the `lib-data` central management plane.&lt;div&gt;The virtual storage is a storage that forwards function calls to all storages that store this database in the order the application has provided as preferable.&lt;/div&gt;&lt;div&gt;Write and full sessions will always be directly access the main storage, while read sessions will iterate through the replicas, until they eventually hit the main storage, if there is any and no read replica.&lt;/div&gt;" vertex="1">
          <mxGeometry height="195" width="440" x="5150" y="2681" as="geometry" />
        </mxCell>
        <mxCell id="CrYzsB_NNo0B62X1mgjU-149" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;i&gt;interface &lt;/i&gt;&lt;/span&gt;ITuple" vertex="1">
