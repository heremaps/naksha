        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-101" parent="bNCgAfvZQ5hsA_kJCly6-97" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="size(): int" vertex="1">
