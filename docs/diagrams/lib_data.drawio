        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-64" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="An implementation of IMap, backed by an object array." vertex="1">
          <mxGeometry height="50" width="540" x="1801" y="750" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-65" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="A helper singleton with low-level access to `byte[]`, `short[]`, `int[]`, `long[]`, `float[]`, and `double[]`. There are methods for each type, so `T[]` stands for each of the above arrays." vertex="1">
          <mxGeometry height="70" width="560" x="2560" y="1212" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-66" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="The list proxy is a base class that can be extended to implement arbitrary types that wrap data lists. A ListProxy must have a constructor that accepts only one parameter being the &lt;b&gt;DataList&lt;/b&gt; it is bound to." vertex="1">
          <mxGeometry height="80" width="440" x="5380" y="850" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-67" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="The map proxy is a base class that can be extended to implement arbitrary types that wrap data maps. A MapProxy must have a constructor that accepts only one parameter being the &lt;b&gt;DataMap&lt;/b&gt; it is bound to." vertex="1">
          <mxGeometry height="80" width="440" x="5900" y="852" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-70" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="The JBON class can be used to encode, decode or read JBON binaries.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;JBON does support data references. When data references are found while encoding, their reference-identifier is written as REFERENCE, the value is given to a data reference writer. When decoding, a data reference resolver is needed to restore the values, otherwise only the data reference is restored with value being `null`. The `resolve` method will read a JBON binary and copy it into a new byte buffer, replacing all references with their real values as returned by the given data reference resolver. There is a default resolved that operates upon&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In Javascript we will only have a `decodeToJson(Int8Array jbon, Int8Array globalDict): String` method. The returned JSON will contain 64-bit integers, so when using in PostgresQL and casted to JSONB, they keep their values, not losing precision!&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="640" x="370" y="2370" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-85" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="&lt;i&gt;interface&lt;/i&gt;&amp;nbsp;IDataReferenceResolver" vertex="1">
          <mxGeometry height="194" width="440" x="1930" y="2449" as="geometry" />
        </mxCell>
