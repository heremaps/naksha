        <mxCell id="AmqFDM5nzbPloSA1pL8--17" parent="XuQO3tHAvvKQnDVfzfl5-97" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="setMutability(boolean mutable)" vertex="1">
