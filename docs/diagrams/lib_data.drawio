        <mxCell id="bNCgAfvZQ5hsA_kJCly6-22" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;abstract&lt;/font&gt;&lt;/i&gt;&amp;nbsp;MapProxy &lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;extends&lt;/font&gt;&lt;/i&gt;&amp;nbsp;Proxy&amp;lt;IMap, MapProxy&amp;gt;" vertex="1">
