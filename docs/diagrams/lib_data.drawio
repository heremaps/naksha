        <mxCell id="XuQO3tHAvvKQnDVfzfl5-38" parent="bNCgAfvZQ5hsA_kJCly6-97" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="getId(): String" vertex="1">
          <mxGeometry height="28" width="440" y="82" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-101" parent="bNCgAfvZQ5hsA_kJCly6-97" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="size(): int" vertex="1">
          <mxGeometry height="28" width="440" y="110" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-102" parent="bNCgAfvZQ5hsA_kJCly6-97" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="get(int index): Object" vertex="1">
          <mxGeometry height="28" width="440" y="138" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-135" parent="bNCgAfvZQ5hsA_kJCly6-97" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="indexOf(Object value): int" vertex="1">
          <mxGeometry height="28" width="440" y="166" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-99" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="A dictionary stores elements, mainly for deduplication. Technically a dictionary is a JBON list of arbitrary primitives and/or DataObject&#39;s, that can be referred by their index. Opening a dictionary JBON automatically decodes it, and creates a caching layer to keep the values in memory." vertex="1">
          <mxGeometry height="112" width="440" x="40" y="1810" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-138" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#666666;strokeWidth=1;fillColor=#f5f5f5;fontColor=#333333;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="The Lib-Data implements classes to handle structured data. Actually, the only types allowed are:&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;null&lt;/b&gt;,&amp;nbsp;&lt;b&gt;String&lt;/b&gt;,&amp;nbsp;&lt;b&gt;Double&lt;/b&gt;,&amp;nbsp;&lt;b&gt;Long&lt;/b&gt;,&amp;nbsp;&lt;b&gt;Boolean&lt;/b&gt;,&amp;nbsp;&lt;b&gt;DataList, DataObject, DataBytes or DataReference&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Whenever other objects are added into data classes, an &lt;b&gt;&lt;i&gt;IllegalArgumentException&lt;/i&gt;&lt;/b&gt; will be thrown. Actually, Integer, Short, and Byte are automatically converted into Long, so is Float converted into Double. However, inside any data structure only the above mentioned primitives can be found.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="870" x="1130" y="30" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-142" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="Legend" vertex="1">
          <mxGeometry height="194" width="440" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-145" parent="bNCgAfvZQ5hsA_kJCly6-142" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="constructor" vertex="1">
          <mxGeometry height="28" width="440" y="26" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-144" parent="bNCgAfvZQ5hsA_kJCly6-142" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="private" vertex="1">
          <mxGeometry height="28" width="440" y="54" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-103" parent="bNCgAfvZQ5hsA_kJCly6-142" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="internal &lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(package private)&lt;/font&gt;&lt;/i&gt;" vertex="1">
          <mxGeometry height="28" width="440" y="82" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-146" parent="bNCgAfvZQ5hsA_kJCly6-142" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="protected" vertex="1">
          <mxGeometry height="28" width="440" y="110" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-105" parent="bNCgAfvZQ5hsA_kJCly6-142" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="public" vertex="1">
          <mxGeometry height="28" width="440" y="138" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-106" parent="bNCgAfvZQ5hsA_kJCly6-142" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="class" vertex="1">
          <mxGeometry height="28" width="440" y="166" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-1" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#666666;strokeWidth=1;fillColor=#f5f5f5;fontColor=#333333;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="Proxies are dynamically attached to data objects&amp;nbsp;at runtime&amp;nbsp;to access the underlying in a type safe manner, and to implement specific interfaces or supportive structures with type-safety.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This runtime linking allows to return always the same proxy for the same underlying, no matter how often requested. Therefore, `bar.proxy(Foo.class) == bar.proxy(Foo.class)` is always true. The `next` property is internally used to chain multiple proxies, when multiple are attached to a single data object.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;Custom proxies must provide at least the linkage constructor (single parameter constructor with the data object to be linked), while custom proxies can implement own real constructors to be used with `new`. Beware that these custom constructors need to call the super linkage constructor with a new data object (super(new ...)). The default super constructors will set the reference to the data object, and they will establish the back-link from the data object to the proxy.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1440" x="280" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-45" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="DataDictTrainer" vertex="1">
          <mxGeometry height="194" width="440" x="40" y="2420" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-46" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="DataDictTrainer(String id)" vertex="1">
          <mxGeometry height="28" width="440" y="26" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-59" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="DataDictTrainer(DataDict dict)" vertex="1">
          <mxGeometry height="28" width="440" y="54" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-49" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;final&lt;/font&gt;&lt;/i&gt; dict: DataDict" vertex="1">
          <mxGeometry height="28" width="440" y="82" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-55" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="learn(Object value): DataDictTrainer" vertex="1">
          <mxGeometry height="28" width="440" y="110" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-63" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="compact(): DataDictTrainer" vertex="1">
          <mxGeometry height="28" width="440" y="138" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-64" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="unlearn(DataDict globalDict): DataDictTrainer" vertex="1">
          <mxGeometry height="28" width="440" y="166" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-60" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="A dictionary trainer is a simple helper class that can be used to generate dictionaries from arbitrary data. The trainer class is subject to optimizations over time. Generally, it learns from all kind of data feed into it and fills the dictionary. Eventually, `compact()` can be used to reduce elements that are likely not useful in a global dictionary, like for example unique identifiers, very short strings or entities that are only rarely found.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;If used to create a local dictionary, `compact()` will not be called, because all strings need to be&amp;nbsp;in the local dictionary. For local dictionaries the `unlearn()` method is used instead, which allows to remove values that are already part of a global dictionary from the local dictionary.&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="440" x="40" y="2160" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-66" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="An object that can be added into a DataList or DataMap as value wrapper. It allows special handling of values, like mutation of values in place. It does come with a numeric identifier, which can be read and set.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(108, 118, 125), rgb(131, 139, 145));&quot;&gt;The reference can be extended for custom use. A data reference is technically transparent, except `getRaw` is used. It can only be removed or replaced using `setRaw`. Otherwise, every data reference is automatically always dereferenced.&lt;/span&gt;&lt;div&gt;A data reference &lt;b&gt;MUST NOT&lt;/b&gt; contain another reference, therefore setting the value will always auto-dereference the value.&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="440" x="2440" y="740" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-67" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="&lt;div&gt;A class that can resolve data references back into their values. This is used for example when certain values of a DataList or DataMap are extracted and stored in separate storage locations, for example in dedicated database columns. Then, when reading back the JBON binary, these references have to be turned into correct-values, so that their values are encoded back into the binary.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Technically this is implemented in the meta data object of a Tuple of the database, and can resolved default, plus custom columns values.&lt;/div&gt;" vertex="1">
          <mxGeometry height="199" width="440" x="1200" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-90" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;abstract&lt;/font&gt;&lt;/i&gt;&amp;nbsp;TypedListProxy&amp;lt;T&amp;gt; &lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;extends&lt;/font&gt;&lt;/i&gt; ListProxy&amp;nbsp;&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;implements&lt;/font&gt;&lt;/i&gt; List&amp;lt;T&amp;gt;" vertex="1">
          <mxGeometry height="82" width="440" x="520" y="1499" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-91" parent="XuQO3tHAvvKQnDVfzfl5-90" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="TypedListProxy(DataList list)" vertex="1">
          <mxGeometry height="28" width="440" y="26" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-96" parent="XuQO3tHAvvKQnDVfzfl5-90" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;abstract&lt;/font&gt;&lt;/i&gt; valueClass(): Class&amp;lt;T&amp;gt;" vertex="1">
          <mxGeometry height="28" width="440" y="54" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-94" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="A small helper class that can be extended to get support for a standard list implementation, enforces type safety. The implementation will throw IllegalStateException when it finds invalid data in the DataList." vertex="1">
          <mxGeometry height="80" width="440" x="520" y="1419" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-97" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="&lt;i style=&quot;font-size: 10px;&quot;&gt;abstract &lt;/i&gt;&lt;font&gt;DataObject&amp;lt;T &lt;i&gt;extends&lt;/i&gt; DataObject, P &lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;extends&lt;/font&gt;&lt;/i&gt; Proxy&amp;lt;T&amp;gt;&amp;gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="222" width="400" x="680" y="160" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-102" parent="XuQO3tHAvvKQnDVfzfl5-97" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;gradientDirection=east;" value="&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;internal&lt;/font&gt;&lt;/i&gt; DataObject()" vertex="1">
          <mxGeometry height="28" width="400" y="26" as="geometry" />
        </mxCell>
        <mxCell id="bNCgAfvZQ5hsA_kJCly6-13" parent="XuQO3tHAvvKQnDVfzfl5-97" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="proxy: P" vertex="1">
