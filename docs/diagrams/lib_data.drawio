        <mxCell id="CrYzsB_NNo0B62X1mgjU-83" parent="CrYzsB_NNo0B62X1mgjU-51" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&amp;lt;T extends NS&amp;gt; register(Class&amp;lt;T&amp;gt; subClass)" vertex="1">
