          <mxGeometry height="28" width="240" y="138" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-106" parent="bNCgAfvZQ5hsA_kJCly6-142" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="class" vertex="1">
          <mxGeometry height="28" width="240" y="166" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-1" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#666666;strokeWidth=1;fillColor=#f5f5f5;fontColor=#333333;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="Proxies are dynamically attached at runtime to JSON or JBON map/array objects to access the underlying in a type safe manner, and to implement specific interfaces or supportive structures with type-safety.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This runtime linking returns always the same proxy for the same underlying, no matter how often requested. Therefore, `bar.proxy(Foo.class) == bar.proxy(Foo.class)` is always true. The `next` property is internally used to chain multiple proxies, when multiple are attached to a single map or array.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;Custom proxies must provide at least the linkage constructor (single parameter constructor with the map or array to be linked), while custom proxies can implement own real constructors to be used with `new`. Beware that these custom constructors need to call the super linkage constructor with a new map or array object that is used as underlying, so `super(new JsonMap())` or `super(new JsonArray())`. The default super constructors will set the reference to the JSON object, and they will establish the back-link from the JSON object to the proxy.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="1080" x="5080" y="590" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-45" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="DataDictTrainer" vertex="1">
          <mxGeometry height="194" width="440" x="2740" y="3330" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-46" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="DataDictTrainer(String id)" vertex="1">
          <mxGeometry height="28" width="440" y="26" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-59" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="DataDictTrainer(DataDict dict)" vertex="1">
          <mxGeometry height="28" width="440" y="54" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-49" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;final&lt;/font&gt;&lt;/i&gt; dict: DataDict" vertex="1">
          <mxGeometry height="28" width="440" y="82" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-55" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="learn(Object value): DataDictTrainer" vertex="1">
          <mxGeometry height="28" width="440" y="110" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-63" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="compact(): DataDictTrainer" vertex="1">
          <mxGeometry height="28" width="440" y="138" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-64" parent="XuQO3tHAvvKQnDVfzfl5-45" style="text;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="unlearn(DataDict globalDict): DataDictTrainer" vertex="1">
          <mxGeometry height="28" width="440" y="166" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-60" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="A dictionary trainer is a simple helper class that can be used to generate dictionaries from arbitrary data. The trainer class is subject to optimizations over time. Generally, it learns from all kind of data feed into it and fills the dictionary. Eventually, `compact()` can be used to reduce elements that are likely not useful in a global dictionary, like for example unique identifiers, very short strings or entities that are only rarely found.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;If used to create a local dictionary, `compact()` will not be called, because all strings need to be&amp;nbsp;in the local dictionary. For local dictionaries the `unlearn()` method is used instead, which allows to remove values that are already part of a global dictionary from the local dictionary.&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="440" x="2740" y="3053" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-67" parent="1" style="html=1;shadow=0;dashed=0;shape=mxgraph.bootstrap.rrect;rSize=5;strokeColor=#999999;strokeWidth=1;fillColor=#FFFFFF;fontColor=#6C767D;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=14;spacing=10;" value="&lt;div&gt;A class that can resolve data references back into their values. This is used for example when certain values of a DataList or DataMap are extracted and stored in separate storage locations, for example in dedicated database columns. Then, when reading back the JBON binary, these references have to be turned into correct-values, so that their values are encoded back into the binary.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Technically this is implemented in the meta data object of a Tuple of the database, and can resolved default, plus custom columns values.&lt;/div&gt;" vertex="1">
          <mxGeometry height="199" width="440" x="1930" y="2250" as="geometry" />
        </mxCell>
        <mxCell id="XuQO3tHAvvKQnDVfzfl5-90" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#dae8fc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;strokeColor=#6c8ebf;" value="&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;abstract&lt;/font&gt;&lt;/i&gt;&amp;nbsp;TypedArrayProxy&amp;lt;T&amp;gt; &lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;extends&lt;/font&gt;&lt;/i&gt;&amp;nbsp;ArrayProxy&amp;nbsp;&lt;i&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;implements&lt;/font&gt;&lt;/i&gt; List&amp;lt;T&amp;gt;" vertex="1">
          <mxGeometry height="82" width="440" x="5380" y="1130" as="geometry" />
        </mxCell>
