{
  "id": "sfw-consistent-dev",
  "type": "Storage",
  "title": "Sfw-consistent-dev PSQL storage",
  "description": "PSQL storage instance for testing purpose",
  "className": "naksha.psql.PsqlStorage",
  "properties": {
    "dbConfig": {
