{
  "id": "test-config",
  "type": "Feature",

  "httpPort": 8080,
  "env": "dev",
  "requestBodyLimit": 25,
  "requestHeaderLimit": 16,
  "authMode": "DUMMY",
  "jwtPvtKeyPath":  "auth/jwt.key",
  "jwtPubKeyPaths": "auth/jwt.pub",
  "maxParallelRequestsPerCPU": 30,
  "maxPctParallelRequestsPerActor": 100,
  "storageParams": {
    "pg_hint_plan": false,
    "pg_stat_statements": false
  },
  "extensionConfigParams": {
    "whitelistClasses": ["java.*","javax.*","com.here.*","jdk.internal.reflect.*","com.sun.*","org.w3c.dom.*","sun.misc.*"],
    "intervalms": 10000,
    "extensionsRootPath": "file:///Users/lakde/Desktop/extensions/"
  }
}