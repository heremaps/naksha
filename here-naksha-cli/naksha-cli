#!/bin/bash
set -e # exit on error

DIR="$(cd "$(dirname "$0")" && pwd)"
"${DIR}"/../gradlew build >> /dev/null

JAR=$(find "${DIR}/build/libs" -name "my-fat-app*.jar" -type f -exec ls -t {} + | head -n 1)

if [[ -f "$JAR" ]]; then
  java -jar "$JAR" "$@"
else
  echo "Error: JAR file not found!" >&2
  exit 1
fi