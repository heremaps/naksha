#!/bin/bash

# script's args have prefix --S (e.g., --Sbuild)
args=("$@")
java_args=()
script_args=()
for arg in "${args[@]}"; do
  if [[ "${arg:0:3}" == "--S" ]]; then
    script_args+=("$arg")
  else
    java_args+=("$arg")
  fi
done

rebuild=false
if [[ " ${script_args[*]} " =~ " --Sbuild " ]]; then
  rebuild=true
fi

CURRENT_DIR="$(pwd)"
cd "$(dirname "$0")"
MODULE_DIR="$(pwd)"
JAR=$(find "${MODULE_DIR}/build/libs/" -name "naksha-cli*.jar" -type f -exec ls -t {} + 2> /dev/null | head -n 1)

if [[ $rebuild == true ]] || ! [[ -f "$JAR" ]] ; then
  echo "Building..."
  stdErr=$(./../gradlew :here-naksha-cli:shadowJar 2>&1 > /dev/null)
  gradle_exit=$?
  if [[ $gradle_exit -ne 0 ]]; then
    echo "Build failed!" >&2
    echo $stdErr >&2
    exit 1
  fi
  JAR=$(find "${MODULE_DIR}/build/libs/" -name "naksha-cli*.jar" -type f -exec ls -t {} + | head -n 1)
fi

cd "$CURRENT_DIR"

if [[ -f "$JAR" ]]; then
  java -jar "$JAR" "${java_args[@]}"
  exit $?
else
  echo "Error: JAR file not found!" >&2
  exit 1
fi